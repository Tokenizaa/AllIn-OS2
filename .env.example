# ============================================================================
# FRONTEND ENVIRONMENT VARIABLES (Accessible in browser)
# ============================================================================
# Only non-sensitive configuration should use VITE_ prefix

VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_API_BASE_URL=/api

# ============================================================================
# BACKEND ENVIRONMENT VARIABLES (Server-side only - NOT accessible in browser)
# ============================================================================
# These should be set in server environment or .env.local for local development
# NEVER commit actual values to version control

# Supabase Service Role Key (for admin operations)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Backend Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/database
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
API_KEY=your-api-key-change-in-production

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
WORKERS_ENABLED=false

# Evolution API Configuration (Server-side only)
EVOLUTION_API_URL=http://localhost:8089
EVOLUTION_API_KEY=your-evolution-api-key
