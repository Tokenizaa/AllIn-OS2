# Playwright E2E — variáveis para a suíte E2E.
# Copie para .env.e2e e preencha. NUNCA use credenciais de produção.

E2E_SUPABASE_URL=
E2E_SUPABASE_ANON_KEY=
E2E_SUPABASE_SERVICE_ROLE_KEY=

E2E_PASSWORD_ADMIN=e2E_Admin!2026
E2E_PASSWORD_FINANCEIRO=e2E_Financ!2026
E2E_PASSWORD_DISTRIBUIDOR=e2E_Distr!2026
E2E_PASSWORD_CLIENTE=e2E_Client!2026

E2E_PORT=5173
E2E_BASE_SPONSOR_CODE=e2e_anchor_sponsor
